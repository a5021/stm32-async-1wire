@PACKAGE_INIT@

set(stm32_async_1wire_OW_TARGET "@OW_TARGET@")
set(stm32_async_1wire_FAMILY "@OW_TARGET@")

if(DEFINED OW_TARGET AND NOT OW_TARGET STREQUAL "@OW_TARGET@")
    message(FATAL_ERROR
        "stm32_async_1wire package targets OW_TARGET=@OW_TARGET@, but the consumer requested OW_TARGET=${OW_TARGET}.")
endif()

find_path(OW_CMSIS_CORE_INCLUDE
    NAMES cmsis_gcc.h
    PATH_SUFFIXES CMSIS/Core/Include Include
    NO_CMAKE_FIND_ROOT_PATH
)
if(NOT OW_CMSIS_CORE_INCLUDE OR NOT EXISTS "${OW_CMSIS_CORE_INCLUDE}/cmsis_gcc.h")
    message(FATAL_ERROR
        "stm32_async_1wire: CMSIS core headers are missing; set OW_CMSIS_CORE_INCLUDE to the directory containing cmsis_gcc.h before find_package().")
endif()

find_path(OW_CMSIS_DEVICE_INCLUDE
    NAMES @CMSIS_DEVICE_HEADER@
    PATH_SUFFIXES
        Include
        CMSIS/Device/ST/STM32F1xx/Include
        CMSIS/Device/ST/STM32F0xx/Include
        CMSIS/Device/ST/STM32G0xx/Include
        Drivers/CMSIS/Device/ST/STM32F1xx/Include
        Drivers/CMSIS/Device/ST/STM32F0xx/Include
        Drivers/CMSIS/Device/ST/STM32G0xx/Include
    NO_CMAKE_FIND_ROOT_PATH
)
if(NOT OW_CMSIS_DEVICE_INCLUDE OR NOT EXISTS "${OW_CMSIS_DEVICE_INCLUDE}/@CMSIS_DEVICE_HEADER@")
    message(FATAL_ERROR
        "stm32_async_1wire: CMSIS device header @CMSIS_DEVICE_HEADER@ is missing; set OW_CMSIS_DEVICE_INCLUDE to the directory containing it before find_package().")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/stm32_async_1wireTargets.cmake")

set_property(TARGET stm32_async_1wire::stm32_async_1wire PROPERTY OW_FAMILY "@OW_TARGET@")
set_property(TARGET stm32_async_1wire::stm32_async_1wire APPEND PROPERTY
    INTERFACE_INCLUDE_DIRECTORIES
        "${OW_CMSIS_CORE_INCLUDE}"
        "${OW_CMSIS_DEVICE_INCLUDE}"
)

check_required_components(stm32_async_1wire)
